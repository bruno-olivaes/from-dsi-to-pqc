\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Regime A: Single-Qubit Coherent Ramsey Echo}{16}{subsection.4.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces \textbf  {Head-to-head performance across 1-qubit coherent Ramsey echo and 4-qubit TFIM Trotter benchmarks.} MAE and standard errors computed across independent random seeds under matched total shot budgets ($N_{\mathrm  {total}} = 24{,}000$ shots/seed). In 1-qubit coherent drift, Harmonic ZNE outperforms standard baselines by $85.4\%$. In 4-qubit multi-mode circuits, Harmonic ZNE diverges ($z < -4.7\,\mathrm  {SE}$), whereas Pauli Twirling + Linear/Exp ZNE reduces error by $80.8\%\text  {--}81.0\%$.}}{17}{table.4.1}\protected@file@percent }
\newlabel{tab:zne_benchmark}{{4.1}{17}{\textbf {Head-to-head performance across 1-qubit coherent Ramsey echo and 4-qubit TFIM Trotter benchmarks.} MAE and standard errors computed across independent random seeds under matched total shot budgets ($N_{\mathrm {total}} = 24{,}000$ shots/seed). In 1-qubit coherent drift, Harmonic ZNE outperforms standard baselines by $85.4\%$. In 4-qubit multi-mode circuits, Harmonic ZNE diverges ($z < -4.7\,\mathrm {SE}$), whereas Pauli Twirling + Linear/Exp ZNE reduces error by $80.8\%\text {--}81.0\%$}{table.4.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Regime B: 4-Qubit Entangled TFIM Trotter Circuit}{17}{subsection.4.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf  {Pre-registered head-to-head quantum error mitigation benchmark on the 4-qubit TFIM Trotter circuit.} (a) Mean Absolute Error $|\hat  {E}(0) - E_{\mathrm  {ideal}}|$ across 20 independent seeds as a function of coherent over-rotation angle $\epsilon $. Damped Harmonic ZNE diverges severely ($\mathrm  {MAE} > 0.36$), while Pauli Twirling + Linear/Exponential ZNE suppresses error to $\le 0.055$. (b) Bar chart at strong coherent drift ($\epsilon = 0.14\,$rad), highlighting the failure of harmonic and exponential fits and the resilience of Pauli Twirling and local linear extrapolation.}}{18}{figure.4.1}\protected@file@percent }
\newlabel{fig:benchmark_results}{{4.1}{18}{\textbf {Pre-registered head-to-head quantum error mitigation benchmark on the 4-qubit TFIM Trotter circuit.} (a) Mean Absolute Error $|\hat {E}(0) - E_{\mathrm {ideal}}|$ across 20 independent seeds as a function of coherent over-rotation angle $\epsilon $. Damped Harmonic ZNE diverges severely ($\mathrm {MAE} > 0.36$), while Pauli Twirling + Linear/Exponential ZNE suppresses error to $\le 0.055$. (b) Bar chart at strong coherent drift ($\epsilon = 0.14\,$rad), highlighting the failure of harmonic and exponential fits and the resilience of Pauli Twirling and local linear extrapolation}{figure.4.1}{}}

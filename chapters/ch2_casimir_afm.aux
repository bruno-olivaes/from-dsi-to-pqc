\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces First-principles electrostatic patch pressure $P_{\mathrm  {patch}}(d)$ calculated by integrating the 2D KPFM Hann-windowed spectrum $S_{VV}(\mathbf  {k})$ of de Jong \textit  {et al.}\ (2025) via the Speake-Trenner Laplace kernel Eq.~\eqref  {eq:speake}. The resulting background follows a smooth, strictly monotonic power law $P_{\mathrm  {patch}} \propto d^{-2.29}$ without periodic oscillatory components.}}{9}{figure.2.3}\protected@file@percent }
\newlabel{fig:kpfm_monotonic}{{2.3}{9}{First-principles electrostatic patch pressure $P_{\mathrm {patch}}(d)$ calculated by integrating the 2D KPFM Hann-windowed spectrum $S_{VV}(\mathbf {k})$ of de Jong \textit {et al.}\ (2025) via the Speake-Trenner Laplace kernel Eq.~\eqref {eq:speake}. The resulting background follows a smooth, strictly monotonic power law $P_{\mathrm {patch}} \propto d^{-2.29}$ without periodic oscillatory components}{figure.2.3}{}}
